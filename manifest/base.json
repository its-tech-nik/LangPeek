{
  "manifest_version": 3,
  "name": "LangPeek",
  "version": "1.0.1",
  "description": "Peek at translations with a middle click. Auto-detects source language.",
  "author": "its.tech.nik",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["browser-polyfill.min.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
